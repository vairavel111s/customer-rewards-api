                  "pm.test('All three months are still reported', () => {",
                  "    pm.expect(body.monthlyBreakdown).to.have.lengthOf(3);",
                  "    body.monthlyBreakdown.forEach((m) => pm.expect(m.pointsEarned).to.eql(0));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/rewards/customers/5",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "rewards", "customers", "5"]
            },
            "description": "An enrolled customer with no purchases. The API returns zeroes rather than an error or an empty body."
          },
          "response": []
        },
        {
          "name": "Rewards — every customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('All six customers are reported', () => {",
                  "    pm.expect(body).to.be.an('array').with.lengthOf(6);",
                  "});",
                  "",
                  "pm.test('Totals match the per-customer endpoints', () => {",
                  "    const totals = {};",
                  "    body.forEach((c) => { totals[c.customerId] = c.totalPoints; });",
                  "    pm.expect(totals[1]).to.eql(884);",
                  "    pm.expect(totals[2]).to.eql(258);",
                  "    pm.expect(totals[3]).to.eql(1849);",
                  "    pm.expect(totals[4]).to.eql(2200);",
                  "    pm.expect(totals[5]).to.eql(0);",
                  "    pm.expect(totals[6]).to.eql(115);",
                  "});",
                  "",
                  "pm.test('Inactive customers are included, not filtered out', () => {",
                  "    pm.expect(body.some((c) => c.customerId === 5)).to.be.true;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/rewards/customers?startDate={{windowStart}}&endDate={{today}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "rewards", "customers"],
              "query": [
                { "key": "startDate", "value": "{{windowStart}}" },
                { "key": "endDate", "value": "{{today}}" }
              ]
            },
            "description": "The same calculation across every customer, served in two database queries regardless of how many customers exist."
          },
          "response": []
        },
        {
          "name": "Rewards — asynchronous endpoint",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('Returns an identical payload to the synchronous endpoint', () => {",
