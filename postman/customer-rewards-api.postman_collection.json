              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/rewards/customers/1/async",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "rewards", "customers", "1", "async"]
            },
            "description": "Runs on a dedicated bounded executor behind a 750ms simulated delay, standing in for a slow downstream data source. The request thread is released while the work is in flight."
          },
          "response": []
        }
      ]
    },
    {
      "name": "03 · Validation & error handling",
      "item": [
        {
          "name": "404 — unknown customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 Not Found', () => pm.response.to.have.status(404));",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('Uses the standard error shape', () => {",
                  "    pm.expect(body).to.have.property('timestamp');",
                  "    pm.expect(body).to.have.property('status', 404);",
                  "    pm.expect(body).to.have.property('error', 'Not Found');",
                  "    pm.expect(body).to.have.property('message');",
                  "    pm.expect(body).to.have.property('path');",
                  "});",
                  "",
                  "pm.test('Message names the offending id', () => {",
                  "    pm.expect(body.message).to.eql('No customer found with id 9999');",
                  "});",
                  "",
                  "pm.test('No stack trace is leaked to the caller', () => {",
                  "    pm.expect(pm.response.text()).to.not.include('at com.retailer');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/rewards/customers/9999",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "rewards", "customers", "9999"]
            }
          },
          "response": []
        },
        {
          "name": "400 — start date after end date",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('Explains what is wrong and names both dates', () => {",
                  "    pm.expect(body.status).to.eql(400);",
                  "    pm.expect(body.message).to.include('must not be after endDate');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/rewards/customers/1?startDate={{today}}&endDate={{windowStart}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "rewards", "customers", "1"],
              "query": [
                { "key": "startDate", "value": "{{today}}" },
                { "key": "endDate", "value": "{{windowStart}}" }
              ]
            },
            "description": "The range is inverted on purpose."
          },
          "response": []
        },
        {
          "name": "400 — malformed date format",
          "event": [
            {
