                  "pm.test('Zero totals rather than a missing or null payload', () => {",
                  "    pm.expect(body.customerName).to.eql('Emily Watson');",
                  "    pm.expect(body.totalPoints).to.eql(0);",
                  "    pm.expect(body.transactions).to.be.an('array').that.is.empty;",
                  "});",
